    if [ -f /home/bticino/cfg/extra/.bridge_autostart ]; then
        cd /home/bticino/cfg/extra
        ./bticino-bridge -config=/home/bticino/cfg/extra/configs/config.yaml >> /tmp/bticino-bridge.log 2>&1 &
        echo "BTicino Bridge started"
    fi
'

