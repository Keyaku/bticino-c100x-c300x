# Generated by iptables-save
# BTicino Bridge Firewall Rules
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -m state --state RELATED,ESTABLISHED -j ACCEPT
-A INPUT -m conntrack --ctstate INVALID -j DROP
-A INPUT -p icmp -m icmp --icmp-type 3 -m state --state NEW,RELATED,ESTABLISHED -m limit --limit 1/sec -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 4 -m state --state NEW,RELATED,ESTABLISHED -m limit --limit 1/sec -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 8 -m state --state NEW,RELATED,ESTABLISHED -m limit --limit 1/sec -j ACCEPT
-A INPUT -p icmp -m icmp --icmp-type 11 -m state --state NEW,RELATED,ESTABLISHED -m limit --limit 1/sec -j ACCEPT
-A INPUT -i lo -j ACCEPT
# BTicino Bridge Services
-A INPUT -p tcp -m tcp --dport 8082 -j ACCEPT
-A INPUT -p tcp -m tcp --dport 8081 -j ACCEPT
# Existing rules (do not remove)
-A INPUT -i usb0 -p tcp -m tcp --dport 20 -j ACCEPT
-A INPUT -i usb0 -p tcp -m tcp --dport 21 -j ACCEPT
-A INPUT -i usb0 -p tcp -m tcp --dport 11111 -j ACCEPT
-A INPUT -i wlan0 -m state --state RELATED,ESTABLISHED -j ACCEPT
-A INPUT -i wlan0 -m conntrack --ctstate INVALID -j DROP
COMMIT
